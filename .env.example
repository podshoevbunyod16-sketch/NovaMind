# ============================================
# NovaMind AI - Environment Configuration
# Скопируй в .env и заполни нужные ключи
# ============================================

# --- Сессия и админ ---
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_CODE=007

# --- AI Провайдеры (минимум один обязателен) ---
# Groq — БЕСПЛАТНО: https://console.groq.com
GROQ_API_KEY=
# Можно добавить до 9 ключей для ротации:
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# Cerebras — БЕСПЛАТНО: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter — есть бесплатные модели: https://openrouter.ai
OPENROUTER_API_KEY=

# --- Локальный ИИ ---
# llama.cpp: запусти ./llama-server -m model.gguf --port 8080
LLAMA_CPP_URL=http://127.0.0.1:8080
# Ollama: запусти ollama serve
OLLAMA_URL=http://localhost:11434

# --- Поиск в интернете ---
# 1. DuckDuckGo — работает БЕЗ ключа, автоматически!
#
# 2. Serper (Google) — 2500 бесплатных запросов/мес
#    Регистрация: https://serper.dev
SERPER_KEY=
#
# 3. Brave Search — 2000 бесплатных запросов/мес
#    Регистрация: https://api.search.brave.com
BRAVE_SEARCH_KEY=
#
# 4. APILayer Google Search — платный, запасной
APILAYER_KEY=

# --- Погода (wttr.in работает БЕЗ ключа!) ---
# Запасной Weatherstack: https://weatherstack.com (бесплатный план)
WEATHERSTACK_KEY=

# --- Валюта (exchangerate-api.com работает БЕЗ ключа!) ---
# Запасной Fixer: https://fixer.io (бесплатный план)
FIXER_KEY=

# --- Новости ---
# NewsAPI — 100 бесплатных запросов/день: https://newsapi.org
NEWS_API_KEY=
# Запасной Mediastack
MEDIASTACK_KEY=

# --- Google OAuth (опционально) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase (опционально, для облачной истории чатов) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Голосовой ответ (0/1) ---
ASSISTANT_VOICE_REPLY=0
