# Flask
FLASK_ENV=development
FLASK_DEBUG=True
# Секрет сессий. Без него ключ генерируется заново при каждом старте и все
# входы «слетают» после перезапуска.
SESSION_SECRET=change-me-please
LOG_LEVEL=INFO
# Внешний адрес сервиса (нужен для OAuth, Referer и абсолютных ссылок).
SITE_URL=http://localhost:5000
PORT=5000

# ══════════ Вход ══════════
# Администратор. Если ADMIN_CODE не задан, при старте генерируется
# одноразовый код и печатается в лог (дефолтного «007» больше нет).
ADMIN_USER=admin
# ADMIN_CODE=задайте-свой

# Google OAuth (кнопка «Войти через Google»). Redirect URI должен совпадать
# с тем, что указан в Google Cloud Console, иначе обмен кода вернёт ошибку.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback

# Необязательно: cloud-провайдеры
# GROQ_API_KEY=...
# CEREBRAS_API_KEY=...
# OPENROUTER_API_KEY=...

# Google AI Studio / Gemini API
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash  # FIX: была опечатка gemini-3.8-flash

# OpenAI-compatible сервер.
# Работает с Ollama, LM Studio, vLLM, LocalAI и удалёнными endpoint'ами.
# Для llama.cpp llama-server используйте OpenAI-compatible API на порту 8080:
# http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.2

# Допустимые альтернативные имена:
# AI_BASE_URL=https://your-host.example.com/v1
# AI_API_KEY=your-key
# AI_MODEL=your-model
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_API_KEY=
# Pollinations.ai — единый провайдер текста, vision, изображений, аудио и видео
# Каталог моделей публичный, но генерация через unified API требует ключ Pollinations.
# Получить ключ: https://enter.pollinations.ai/
# Рекомендуется хранить секретный ключ только на сервере.
# POLLINATIONS_API_KEY=sk_...
# Алиасы для совместимости:
# POLLINATIONS_KEY=sk_...
# POLLINATIONS_TOKEN=sk_...

# LOCAL_LLM_MODEL=local-model

# Аудио: OpenAI/Groq-compatible transcription и TTS
# AUDIO_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# AUDIO_TTS_URL=https://api.openai.com/v1/audio/speech
# AUDIO_TTS_MODEL=tts-1
# AUDIO_API_KEY=

# Изображения: если ключа нет, используется Pollinations.ai
# IMAGE_GENERATION_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=

# Видео: универсальный endpoint конкретного video-провайдера
# ВАЖНО: подтверждённого бесплатного API для генерации видео сейчас нет
# (Veo доступен только на платном тарифе Gemini API), поэтому видео-модель
# подключается явно через свой endpoint и в каталоге помечается «цена не подтверждена».
# VIDEO_API_URL=https://your-video-provider.example/v1/videos
# VIDEO_MODEL=your-video-model
# VIDEO_API_KEY=

# ══════════ Единая панель медиа-моделей (изображения / аудио / видео) ══════════
# Каталог строится из подключённых провайдеров:
#   * GEMINI_API_KEY  → Google AI Studio (TTS бесплатно; image/video — платно)
#   * GROQ_API_KEY    → Groq /v1/audio/speech (бесплатный тариф с лимитами)
#   * OPENROUTER_API_KEY → живой каталог OpenRouter, цены берутся из ответа API
#   * без ключа       → Pollinations (image/audio, бесплатный endpoint)
# Платные модели и модели с неподтверждённой ценой автоматически не используются:
# их нужно выбрать вручную с явным подтверждением в интерфейсе.
# Премиум-модели Pollinations (кредиты Pollen):
# POLLINATIONS_TOKEN=

# Параметры сервера
HOST=0.0.0.0
PORT=5000

# ══════════ Поиск в интернете ══════════
# Порядок поисковых бэкендов (перебираются до первой успешной выдачи):
#   weather, searxng, ddg, wiki
# Погода работает через Open-Meteo без ключа; ddg использует httpx + BeautifulSoup4.
# SEARCH_BACKENDS=weather,searxng,ddg,wiki
# Somon.tj — только для объявлений; не включается автоматически.
# SEARCH_BACKENDS=sites,weather,searxng,ddg,wiki
# SITES_SEARCH_AUTO=0
#
# Свои инстансы SearXNG (через запятую) — например, собственный docker:
# SEARXNG_INSTANCES=http://127.0.0.1:8888,https://searx.be
#
# Зеркала MediaWiki API для бэкенда wiki:
# WIKI_API_BASES=https://ru.wikipedia.org/w/api.php,https://en.wikipedia.org/w/api.php
#
# Таймауты (секунды):
# SEARCH_TIMEOUT=9          — поисковый бэкенд
# READER_TIMEOUT=10         — чтение найденных страниц
# SEARCH_MAX_PAGES=3        — сколько страниц успеваем прочитать до ответа
# SEARCH_QUERY_TIMEOUT=10   — служебные запросы к модели (поисковый запрос и т.п.)
# ANSWER_TIMEOUT=180        — ответ модели по найденным источникам.
#                             Больше, потому что у reasoning-моделей первый токен идёт долго.
#
# Ключи коммерческих поисковых API (необязательно):
# APILAYER_KEY=
# SERPER_KEY=

# ══════════ Маленький Linux: песочница, терминал, задачи ══════════
# Выключено по умолчанию. После включения доступно любому, кто вошёл
# в аккаунт: через Google, другой OAuth или по нику (серверная сессия
# ставится автоматически при входе). Админом быть не обязательно.
# TERMINAL_STRICT_ADMIN=1 — если нужен прежний режим «только администратор».
# Песочница — это папка проекта с белым списком команд и лимитами,
# а не полноценный shell: |, >, &&, sudo и выход за пределы папки запрещены.
# TERMINAL_ENABLED=1
#
# Где живёт рабочая папка (по умолчанию ./workspace рядом с app.py):
# TERMINAL_DIR=/var/lib/novamind/workspace
#
# Лимиты терминала:
# TERMINAL_TIMEOUT=20      — секунд на одну команду
# TERMINAL_MAX_OUTPUT=12000 — символов вывода (остальное обрезается)

# ══════════ ИИ-агент в главном чате ══════════
# Кнопок «Агент» и «Медиа» нет: каждое сообщение уходит агенту, и он сам
# выбирает, что делать — ответить, поискать в интернете, нарисовать картинку,
# озвучить текст, сделать видео или поработать в Linux (при TERMINAL_ENABLED=1).
# Агент включён по умолчанию для всех, кто вошёл. AGENT_ENABLED=0 — старый чат.
# AGENT_ENABLED=1
# AGENT_MAX_STEPS=20       — общий лимит инструментальных шагов за один запрос
# AGENT_TIMEOUT=240        — общий лимит времени на ответ
# AGENT_STEP_TIMEOUT=30    — лимит на одну команду в Linux
# AGENT_NATIVE_TOOLS=1     — нативный tool calling (функции вместо JSON-действий).
#                            Если провайдер не принял `tools`, агент сам
#                            возвращается к старому JSON-протоколу. 0 — только JSON.
# AI_NATIVE_TOOLS=1        — глобальный выключатель нативных инструментов в ai_providers.
# AGENT_CONFIRM=danger     — спрашивать разрешение: danger | write (и write-шаги) | off.
# AGENT_CONFIRM_TIMEOUT=120 — сколько секунд ждать ответа, дальше — отказ.
# MEMORY_ENABLED=1         — долгосрочная память (только для вошедших; гостям выключена).
#
# Защита от перебора пароля админки (этап 7):
# ADMIN_LOGIN_MAX_ATTEMPTS=5 — сколько неудачных попыток разрешено
# ADMIN_LOGIN_WINDOW=600     — окно в секундах (10 минут); блок отдельно по IP и по аккаунту
#
# Лимит запросов к агенту (этап 7):
# AGENT_RATE_LIMIT=1         — 0 полностью выключает ограничение
# AGENT_RATE_GUEST=30        — запросов в час для гостя
# AGENT_RATE_USER=200        — запросов в час для вошедшего
# AGENT_RATE_WINDOW=3600     — окно в секундах
#
# Задачи по расписанию (бонус Б4):
# SCHEDULER_ENABLED=1        — фоновый поток, который выполняет задания
# SCHEDULER_TICK=30          — как часто проверять, кому пора (секунды)
# Задания ставятся агентом (инструмент schedule) или через POST /api/schedule:
#   {"prompt": "сводка новостей", "cron": "0 9 * * *"}
#   {"prompt": "проверь сайт", "every": "30m"}
# Результаты приходят в отдельный чат «⏰ Расписание».
#
# Telegram-бот (бонус Б5). Токен берётся ТОЛЬКО отсюда — в коде его нет.
# Запуск отдельным процессом: python telegram_bot.py
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_ENABLED=1            — 0 временно выключает бота
# TELEGRAM_ALLOWED_USERS=        — id через запятую; пусто — пускаем всех
# TELEGRAM_POLL_TIMEOUT=25       — сколько секунд ждать обновления (long polling)
#
# Инструменты: search, open, image, audio, video, media_models — всегда;
# run, read, write, ls — только с TERMINAL_ENABLED=1.
#
# Модель генерации медиа агент выбирает сам: сначала свой endpoint из .env
# (IMAGE_GENERATION_URL / AUDIO_TTS_URL / VIDEO_API_URL), потом бесплатные модели
# подключённых провайдеров (Pollinations, OpenRouter :free, Gemini/Groq TTS).
# Если провайдер отказал — пробует следующую модель (до MEDIA_MAX_ATTEMPTS).
# Платные модели и пробные кредиты (Nano Banana, Veo) автоматически НЕ берутся —
# разрешить явно:
# MEDIA_ALLOW_PAID=1
# MEDIA_MAX_ATTEMPTS=3

# ══════════ Локальная модель без облака ══════════
# Автопоиск запущенного OpenAI-compatible сервера (llama.cpp / Ollama /
# LM Studio): если ключей нет, чат сам переключится на локальную модель.
# LOCAL_LLM_AUTODETECT=1
# Имя и контекст локальной модели (для провайдера openai_compatible):
# LOCAL_MODEL_ID=llama3.2
# LOCAL_MODEL_NAME=Local model
# LOCAL_MODEL_CONTEXT=8192

# ══════════ MCP ══════════
# MCP_CONNECTIONS_FILE=mcp_connections.json
# MCP_TIMEOUT=20
# COMPOSIO_API_KEY=

# ══════════ Кодирующий агент (/api/agent/coding/*) ══════════
# Доступен всем вошедшим пользователям и honours AGENT_ENABLED.
# CODING_AGENT_MAX_STEPS=20
# CODING_AGENT_TIMEOUT=600

# ══════════ Прочее ══════════
# APP_TITLE=NovaMind
# SYSTEM_PROMPT=   — дополнительная инструкция к системному промпту
# ASSISTANT_VOICE_REPLY=0
# VISION_PROVIDER=
# VISION_MODEL=
# NOVAMIND_MEDIA_DIR=generated_media
# NOVAMIND_SKILLS_DIR=user_skills
# NOVAMIND_IMAGE_DIR=generated_media
# NO_NETWORK=0

# ══════════ Озвучка ответов (TTS) ══════════
# Провайдер берётся по приоритету: уже подключённый TTS → бесплатные сервисы.
#   GEMINI_API_KEY      → Google AI Studio (Gemini TTS, 28 голосов, ru + en)
#   GROQ_API_KEY        → Groq PlayAI (бесплатно, но голоса только английские)
#   POLLINATIONS_API_KEY→ Pollinations Audio
#   AUDIO_TTS_URL       → свой OpenAI-совместимый /audio/speech
# Ключи остаются на сервере: браузер получает только готовый звук.
# TTS_MAX_CHARS=8000        — максимум текста на один запрос
# TTS_CHUNK_CHARS=900       — размер части (делим по границам предложений)
# TTS_MAX_CHUNKS=12         — сколько частей максимум озвучиваем за раз
# TTS_TIMEOUT=90            — таймаут одного запроса к провайдеру, секунды
# TTS_FILE_TTL=3600         — через сколько удалять старые файлы озвучки
# TTS_FILE_KEEP=200         — сколько последних файлов озвучки не трогать
# TTS_RATE_LIMIT=1          — 0 отключает лимит запросов на озвучку
# TTS_RATE_USER=120         — запросов в час для вошедшего пользователя
# TTS_RATE_GUEST=30         — запросов в час для гостя
# TTS_RATE_WINDOW=3600      — окно лимита в секундах
