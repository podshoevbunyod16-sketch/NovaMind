# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-me

# Необязательно: cloud-провайдеры
# GROQ_API_KEY=...
# CEREBRAS_API_KEY=...
# OPENROUTER_API_KEY=...

# Google AI Studio / Gemini API
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash  # FIX: была опечатка gemini-3.8-flash

# OpenAI-compatible сервер.
# Работает с Ollama, LM Studio, vLLM, LocalAI и удалёнными endpoint'ами.
# Для llama.cpp llama-server используйте OpenAI-compatible API на порту 8080:
# http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.2

# Допустимые альтернативные имена:
# AI_BASE_URL=https://your-host.example.com/v1
# AI_API_KEY=your-key
# AI_MODEL=your-model
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1
# LOCAL_LLM_API_KEY=
# Pollinations.ai — единый провайдер текста, vision, изображений, аудио и видео
# Каталог моделей публичный, но генерация через unified API требует ключ Pollinations.
# Получить ключ: https://enter.pollinations.ai/
# Рекомендуется хранить секретный ключ только на сервере.
# POLLINATIONS_API_KEY=sk_...
# Алиасы для совместимости:
# POLLINATIONS_KEY=sk_...
# POLLINATIONS_TOKEN=sk_...

# LOCAL_LLM_MODEL=local-model

# Аудио: OpenAI/Groq-compatible transcription и TTS
# AUDIO_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# AUDIO_TTS_URL=https://api.openai.com/v1/audio/speech
# AUDIO_TTS_MODEL=tts-1
# AUDIO_API_KEY=

# Изображения: если ключа нет, используется Pollinations.ai
# IMAGE_GENERATION_URL=https://api.openai.com/v1/images/generations
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY=

# Видео: универсальный endpoint конкретного video-провайдера
# ВАЖНО: подтверждённого бесплатного API для генерации видео сейчас нет
# (Veo доступен только на платном тарифе Gemini API), поэтому видео-модель
# подключается явно через свой endpoint и в каталоге помечается «цена не подтверждена».
# VIDEO_API_URL=https://your-video-provider.example/v1/videos
# VIDEO_MODEL=your-video-model
# VIDEO_API_KEY=

# ══════════ Единая панель медиа-моделей (изображения / аудио / видео) ══════════
# Каталог строится из подключённых провайдеров:
#   * GEMINI_API_KEY  → Google AI Studio (TTS бесплатно; image/video — платно)
#   * GROQ_API_KEY    → Groq /v1/audio/speech (бесплатный тариф с лимитами)
#   * OPENROUTER_API_KEY → живой каталог OpenRouter, цены берутся из ответа API
#   * без ключа       → Pollinations (image/audio, бесплатный endpoint)
# Платные модели и модели с неподтверждённой ценой автоматически не используются:
# их нужно выбрать вручную с явным подтверждением в интерфейсе.
# Премиум-модели Pollinations (кредиты Pollen):
# POLLINATIONS_TOKEN=

# Параметры сервера
HOST=0.0.0.0
PORT=5000

# ══════════ Поиск в интернете ══════════
# Порядок поисковых бэкендов (перебираются до первой успешной выдачи):
#   apilayer, serper, searxng, ddg, ddg_lite, wiki
# SEARCH_BACKENDS=searxng,ddg,ddg_lite,wiki
#
# Свои инстансы SearXNG (через запятую) — например, собственный docker:
# SEARXNG_INSTANCES=http://127.0.0.1:8888,https://searx.be
#
# Зеркала MediaWiki API для бэкенда wiki:
# WIKI_API_BASES=https://ru.wikipedia.org/w/api.php,https://en.wikipedia.org/w/api.php
#
# Таймауты (секунды):
# SEARCH_TIMEOUT=9
# READER_TIMEOUT=14
#
# Ключи коммерческих поисковых API (необязательно):
# APILAYER_KEY=
# SERPER_KEY=
