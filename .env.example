# ============================================
# NovaMind AI - Environment Configuration
# Скопируй в .env и заполни нужные ключи
# ============================================

# --- Сессия и админ ---
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_CODE=007

# --- AI Провайдеры (минимум один обязателен) ---
# Groq (рекомендуется основным)
GROQ_API_KEY=
# Можно добавить до 9 ключей для ротации:
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# Cerebras (резерв)
CEREBRAS_API_KEY=

# OpenRouter (запасной)
OPENROUTER_API_KEY=

# --- Google OAuth (опционально, для входа через Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase (опционально, для облачной истории чатов) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Composio / MCP Servers (опционально) ---
COMPOSIO_API_KEY=

# --- APILayer интеграции (опционально: погода, валюта, новости) ---
# Один ключ APILayer покрывает все сервисы
APILAYER_KEY=
# Можно переопределить отдельные сервисы:
WEATHERSTACK_KEY=
FIXER_KEY=
MEDIASTACK_KEY=

# --- Прочие API ---
NUMBER_VERIFICATION_API=
APP_CENTER_API_KEY=
EMAIL_VERIFICATION=

# --- Голосовой ответ (0/1) ---
ASSISTANT_VOICE_REPLY=0