diff --git a/static/style.css b/static/style.css
--- a/static/style.css
+++ b/static/style.css
@@ -1259,0 +1260,18 @@ button, input, select, textarea, .stage, .sources-head, .msg-actions {
+
+/* Разрешения внутри блока «Шаги»: строка-аккордеон, а не отдельная карточка */
+.agent-term-log .agent-confirm {
+  margin: 6px 0; padding: 0; overflow: hidden;
+}
+.agent-term-log .agent-confirm-head {
+  width: 100%; padding: 8px 11px; font: inherit; font-size: 12px; font-weight: 600;
+  color: inherit; background: transparent; border: 0; text-align: left; cursor: pointer;
+}
+.agent-confirm-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.agent-confirm-head .caret { font-size: 9px; color: var(--txt-dim); transition: transform .18s ease; }
+.agent-confirm.is-open .agent-confirm-head .caret { transform: rotate(180deg); }
+.agent-confirm-body, .agent-confirm-actions { display: none; padding: 0 11px; }
+.agent-confirm.is-open .agent-confirm-body { display: block; }
+.agent-confirm.is-open .agent-confirm-actions { display: flex; padding-bottom: 10px; }
+.agent-confirm.is-approved { border-color: rgba(93, 214, 154, .4); background: rgba(93, 214, 154, .07); }
+.agent-confirm.is-denied { border-color: rgba(255, 118, 118, .4); background: rgba(255, 118, 118, .07); }
+.agent-term.is-done .agent-confirm { opacity: 1; }
