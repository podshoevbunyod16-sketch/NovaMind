diff --git a/routes/agent.py b/routes/agent.py
--- a/routes/agent.py
+++ b/routes/agent.py
@@ -315,0 +316,52 @@ def strip_think(text):
+# ── «Рассуждения» без тегов ──────────────────────────────────────────────
+# Некоторые бесплатные модели (minimax, qwen и др.) пишут ход мыслей прямо в
+# content по-английски («We need answer Russian…») и без <think>. strip_think
+# такое не видит, и рассуждение попадало в чат вместо ответа.
+_LEAK_START = re.compile(
+    r"^\W*(?:we need|we should|we must|we have|let'?s|let me|the user|user (?:asks|asked|wants|says)|"
+    r"need to|i need|i should|i'll|i will|okay|ok,|hmm|first,|so we|they (?:supplied|provided|ask)|"
+    r"looking at|given (?:the|that)|probably|maybe|now,|thus|therefore|alright|actually)\b", re.I)
+_CYR = re.compile(r"[А-Яа-яЁё]")
+_LAT = re.compile(r"[A-Za-z]")
+
+
+def _has_cyrillic(text):
+    return bool(_CYR.search(text or ""))
+
+
+def _split_paragraphs(text):
+    return [p.strip() for p in re.split(r"\n\s*\n", text or "") if p.strip()]
+
+
+def looks_like_leaked_reasoning(text):
+    """True, если текст начинается как английское рассуждение модели."""
+    text = strip_think(text)
+    if not text:
+        return False
+    if _LEAK_START.match(text):
+        return True
+    first = _split_paragraphs(text)[0]
+    cyr, lat = len(_CYR.findall(first)), len(_LAT.findall(first))
+    return lat > 40 and lat > cyr * 2
+
+
+def strip_leaked_reasoning(text, goal=""):
+    """Убирает из ответа утёкшее рассуждение; если ответа под ним нет — пустая строка.
+
+    Работает только для русскоязычных запросов: английский ответ на английский
+    вопрос («Let me explain…») — это не утечка.
+    """
+    text = strip_think(text)
+    if not text or not _has_cyrillic(goal) or not looks_like_leaked_reasoning(text):
+        return text
+    tail = []
+    for para in reversed(_split_paragraphs(text)):
+        cyr, lat = len(_CYR.findall(para)), len(_LAT.findall(para))
+        is_draft = para[:1] in "\"'«“„" or bool(_LEAK_START.match(para))
+        if is_draft or cyr < 15 or cyr < lat * 1.5:
+            break
+        tail.append(para)
+    answer = "\n\n".join(reversed(tail)).strip()
+    return answer if len(answer) >= 40 else ""
+
+
